{
  "name": "bflayout",
  "version": "0.1.0",
  "description": "Layout file editor for Nintendo Switch BFLYT and related formats",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "pnpm typecheck:shared && pnpm typecheck:node && pnpm typecheck:preload && pnpm typecheck:web",
    "typecheck:shared": "tsc --noEmit -p tsconfig.shared.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:preload": "tsc --noEmit -p tsconfig.preload.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "fixture:archive": "tsx --tsconfig tsconfig.node.json scripts/make-fixture-archive.ts",
    "package": "electron-vite build && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "validate:romfs": "tsx --tsconfig tsconfig.node.json scripts/validate-romfs.ts",
    "validate:astc": "tsx --tsconfig tsconfig.node.json scripts/validate-astc.ts",
    "validate:byml": "tsx --tsconfig tsconfig.node.json scripts/validate-byml.ts",
    "diag:prt1": "tsx --tsconfig tsconfig.node.json scripts/diag-prt1.ts",
    "diag:pai1": "tsx --tsconfig tsconfig.node.json scripts/diag-pai1.ts",
    "diag:bflan": "tsx --tsconfig tsconfig.node.json scripts/diag-bflan.ts"
  },
  "dependencies": {
    "@bokuweb/zstd-wasm": "0.0.27",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@orpc/client": "^1.14.15",
    "@orpc/contract": "^1.14.15",
    "@orpc/server": "^1.14.15",
    "@orpc/tanstack-query": "^1.14.15",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.23",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "effect": "^3.22.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  }
}
